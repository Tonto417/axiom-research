---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/axiom-research/favicon.svg" />
        <title>{title} // Axiom Research Group</title>
    </head>
    <body class="h-full flex flex-col font-sans antialiased selection:bg-emerald-500 selection:text-slate-950">
        <slot />
    </body>
</html>
<style is:global>
    @import "tailwindcss";
</style>
