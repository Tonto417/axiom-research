---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const allAdvisories = await getCollection('advisories');
const sortedAdvisories = allAdvisories.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Advisories">
    <Navigation />
    
    <main class="flex-grow max-w-4xl mx-auto px-6 py-16 w-full">
        <div class="space-y-8">
            <div>
                <span class="font-mono text-xs text-emerald-400 tracking-wider uppercase">// SECURITY RESEARCH</span>
                <h1 class="text-3xl md:text-5xl font-black tracking-tight text-white mt-2">
                    Advisories & Disclosures
                </h1>
            </div>

            <div class="space-y-4">
                {sortedAdvisories.map((advisory) => (
                    <a href={`/axiom-research/advisories/${advisory.slug}`} class="block border border-slate-900 bg-slate-900/30 p-6 rounded-lg space-y-3 hover:border-emerald-500/50 transition-colors">
                        <div class="flex items-center justify-between font-mono text-xs text-slate-500">
                            <span>{advisory.data.date.toISOString().split('T')[0]}</span>
                            <span class="px-2 py-0.5 rounded bg-red-950/50 border border-red-800/50 text-red-400 font-bold">
                                {advisory.data.severity}
                            </span>
                        </div>
                        <h2 class="text-xl font-bold text-white">
                            {advisory.data.title}
                        </h2>
                        <p class="text-sm text-slate-400 font-light">
                            {advisory.data.description}
                        </p>
                    </a>
                ))}
            </div>
        </div>
    </main>

    <Footer />
</Layout>
