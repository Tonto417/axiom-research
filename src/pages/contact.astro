---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Secure Contact & PGP">
    <Navigation />
    
    <main class="flex-grow max-w-4xl mx-auto px-6 py-16 w-full">
        <div class="space-y-8">
            <div>
                <span class="font-mono text-xs text-emerald-400 tracking-wider uppercase">// ENCRYPTED COMMUNICATIONS</span>
                <h1 class="text-3xl md:text-5xl font-black tracking-tight text-white mt-2">
                    Secure Contact & PGP
                </h1>
            </div>

            <div class="space-y-6 text-slate-300 font-light leading-relaxed">
                <section class="border border-slate-900 bg-slate-900/30 p-6 rounded-lg space-y-4">
                    <h2 class="text-white font-mono font-bold text-lg text-emerald-400">PGP Key Details</h2>
                    <p class="text-sm">
                        For sensitive vulnerability submissions, please encrypt your communications using our official PGP public key.
                    </p>
                    <div class="font-mono text-xs bg-slate-950 p-4 rounded border border-slate-800 text-slate-400 overflow-x-auto">
                        <p class="text-emerald-400 font-bold mb-1">Fingerprint:</p>
                        <p>4A1F 8C92 3BEE 4421 90CC  7512 D834 11A0 E922 4F11</p>
                    </div>
                </section>

                <section class="border border-slate-900 bg-slate-900/30 p-6 rounded-lg space-y-3">
                    <h2 class="text-white font-mono font-bold text-lg text-emerald-400">Direct Inquiries</h2>
                    <p class="text-sm">
                        Non-urgent technical correspondence and operational inquiries can be directed through secure organizational email channels.
                    </p>
                    <div class="font-mono text-xs text-emerald-400 pt-2">
                        <span>// EMAIL: security@axiom-research.internal</span>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <Footer />
</Layout>
