---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
    const advisories = await getCollection('advisories');
    return advisories.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
    <Navigation />
    
    <main class="flex-grow max-w-4xl mx-auto px-6 py-16 w-full">
        <div class="space-y-8">
            <div class="space-y-3">
                <a href="/axiom-research/advisories" class="font-mono text-xs text-emerald-400 hover:underline">
                    &larr; // BACK TO ADVISORIES
                </a>
                <div class="flex items-center space-x-4 font-mono text-xs text-slate-500 pt-2">
                    <span>{entry.data.date.toISOString().split('T')[0]}</span>
                    <span class="px-2 py-0.5 rounded bg-red-950/50 border border-red-800/50 text-red-400 font-bold">
                        {entry.data.severity}
                    </span>
                    <span>AUTHOR: {entry.data.author}</span>
                </div>
                <h1 class="text-3xl md:text-4xl font-black tracking-tight text-white">
                    {entry.data.title}
                </h1>
            </div>

            <article class="prose prose-invert prose-emerald max-w-none border border-slate-900 bg-slate-900/30 p-8 rounded-lg font-light leading-relaxed text-slate-300 space-y-6">
                <Content />
            </article>
        </div>
    </main>

    <Footer />
</Layout>
