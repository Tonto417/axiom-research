---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Home">
    <Navigation />

            <main class="flex-grow max-w-7xl mx-auto px-6 py-16 w-full">
                    <div class="space-y-6">
                                <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-emerald-950/50 border border-emerald-800/50 text-emerald-400 font-mono text-xs">
                                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                                                <span>SYSTEM ONLINE // SECURE NODE</span>
                                                                            </div>

                                                                                                    <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white">
                                                                                                                    Axiom Research Group
                                                                                                                                </h1>

                                                                                                                                                        <p class="text-slate-400 text-lg max-w-2xl font-light">
                                                                                                                                                                        Independent cybersecurity research, vulnerability disclosures, and technical infrastructure documentation.
                                                                                                                                                                                    </p>

                                                                                                                                                                                                <div class="pt-8 grid grid-cols-1 md:grid-cols-3 gap-6 font-mono text-sm">
                                                                                                                                                                                                                <div class="border border-slate-900 bg-slate-900/40 p-6 rounded-lg">
                                                                                                                                                                                                                                    <h2 class="text-emerald-400 font-bold mb-2">// ADVISORIES</h2>
                                                                                                                                                                                                                                                        <p class="text-slate-400 text-xs font-sans">Verified vulnerability write-ups and mitigation strategies.</p>
                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                        <div class="border border-slate-900 bg-slate-900/40 p-6 rounded-lg">
                                                                                                                                                                                                                                                                                                            <h2 class="text-emerald-400 font-bold mb-2">// PROTOCOLS</h2>
                                                                                                                                                                                                                                                                                                                                <p class="text-slate-400 text-xs font-sans">System architecture specifications and deployment logs.</p>
                                                                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                                                                                <div class="border border-slate-900 bg-slate-900/40 p-6 rounded-lg">
                                                                                                                                                                                                                                                                                                                                                                                    <h2 class="text-emerald-400 font-bold mb-2">// DISCLOSURE</h2>
                                                                                                                                                                                                                                                                                                                                                                                                        <p class="text-slate-400 text-xs font-sans">Secure communication channels and PGP fingerprint data.</p>
                                                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                </main>

                                                                                                                                                                                                                                                                                                                                                                                                                                                    <Footer />
                                                                                                                                                                                                                                                                                                                                                                                                                                                    </Layout>
                                                                                                                                                                                                                                                                                                                                                                                                                                                    
